# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/cv_tailor

# ─── Better Auth ─────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Gemini ──────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional override for the Gemini model used by all calls in src/lib/gemini.ts.
# Defaults to "gemini-3.1-pro-preview". Use this for A/B model evaluation
# (see scripts/eval-tailor.ts) or to swap to a stable model post-eval.
# Candidates: gemini-2.5-pro, gemini-2.5-flash, gemini-3.1-pro-preview
# GEMINI_MODEL=gemini-2.5-pro

# Set to "1" to silence per-call token usage logs.
# TAILOR_LOG_USAGE=0
# Set to "1" to skip the self-critique pass for cost-sensitive flows.
# TAILOR_SKIP_CRITIQUE=1

# ─── Cloudflare R2 (object storage) ──────────────────────────────────
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
